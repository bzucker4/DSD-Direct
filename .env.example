# ---------------------------------------------------------------------------
# DSD Direct environment. Copy to .env for local dev; on Netlify set the same
# keys under Site configuration → Environment variables. All VITE_* values are
# baked into the public JS bundle at build time: never put secrets here
# (no service_role key, no DB password).
# ---------------------------------------------------------------------------

# --- Supabase (required) ---------------------------------------------------
# Project Settings → API (Data API URL + anon / publishable key)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# --- Branding (all optional) ------------------------------------------------
# Empty or unset = the default shown in the comment (the stock DSD Direct /
# Demo Beverage Distributing look). See docs/WHITE_LABEL.md.

# Asset folder: public/brands/<slug>/ with favicon.svg, pwa-192.png, pwa-512.png
# (missing files fall back to public/brands/default/). Default: default
VITE_BRAND_SLUG=
# App name (login heading, sidebar, <title>, PWA name). Default: DSD Direct
VITE_BRAND_PRODUCT_NAME=
# PWA short_name + iOS home-screen title (keep <= 12 chars). Default: product name
VITE_BRAND_SHORT_NAME=
# Client / distributor name. Default: Demo Beverage Distributing
VITE_BRAND_COMPANY_NAME=
# Login subtitle + <title> suffix. Default: Warehouse & Field Sales
VITE_BRAND_TAGLINE=
# Sidebar tagline. Default: WMS + Field Sales
VITE_BRAND_NAV_TAGLINE=
# Top header sentence. Default: Functional & modern warehouse + field sales for DSD distributors
VITE_BRAND_HEADLINE=
# PWA manifest description. Default: Warehouse WMS + field sales for DSD distributors
VITE_BRAND_DESCRIPTION=
# <meta name="description">. Default: "<product> — Warehouse WMS + field sales for <company> DSD distributors"
VITE_BRAND_META_DESCRIPTION=
# Distribution center label. Default: Rochester DC
VITE_BRAND_DC_NAME=
# Route label next to the DC in the header. Default: Route 12
VITE_BRAND_ROUTE_LABEL=
# Initials in the logo badge (max 3). Default: initials of the product name (DD)
VITE_BRAND_LOGO_TEXT=
# Logo image instead of the initials badge: a file name inside the brand folder
# (e.g. logo.svg), a /root path or an https URL. Default: none (badge)
VITE_BRAND_LOGO_URL=
# Favicon: file in the brand folder, /path or URL. Default: favicon.svg
VITE_BRAND_FAVICON=
# Main color (buttons, links, active nav; palette 600), hex. Default: #2563eb
VITE_BRAND_PRIMARY_COLOR=
# Darker accent (logo gradient, browser/PWA theme-color; palette 800), hex. Default: #1e40af
VITE_BRAND_ACCENT_COLOR=
# Page + PWA splash background, hex. Default: #f8fafc
VITE_BRAND_BACKGROUND_COLOR=
# Support contact on the login + account pages. Default: none (hidden)
VITE_BRAND_SUPPORT_EMAIL=
# Demo mode: demo-account banner, demo notices and the login demo-account picker.
# true/false. Default: true (set false for a production client)
VITE_BRAND_SHOW_DEMO_BANNER=
# Email domain of the demo accounts (warehouse@, field@, admin@). Default: dsddirect.demo
VITE_BRAND_DEMO_EMAIL_DOMAIN=
